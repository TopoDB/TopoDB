{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/session-start.js" }]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [{ "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/subagent-start.js" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__(plugin_topodb_)?topodb__(search_memories|traverse|recent_memories)",
        "hooks": [{ "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/post-tool-use.js" }]
      },
      {
        "matcher": "mcp__(plugin_topodb_)?topodb__(remember|create_memory)",
        "hooks": [{ "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/mark-captured.js" }]
      },
      {
        "matcher": "^(Read|Bash|Edit|Write|MultiEdit|Grep|Glob|WebFetch)$",
        "hooks": [{ "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/warehouse-capture.js" }]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [{ "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/session-end.js" }]
      }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/stop-capture.js" }] }
    ]
  }
}
