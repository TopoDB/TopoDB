{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [{ "type": "command", "command": "node ${PLUGIN_ROOT}/hooks/session-start.js" }]
      },
      {
        "matcher": "compact",
        "hooks": [{ "type": "command", "command": "node ${PLUGIN_ROOT}/hooks/session-start.js" }]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [{ "type": "command", "command": "node ${PLUGIN_ROOT}/hooks/warehouse-capture.js", "async": true }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "node ${PLUGIN_ROOT}/hooks/stop.js" }]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [{ "type": "command", "command": "node ${PLUGIN_ROOT}/hooks/session-end.js" }]
      }
    ]
  }
}
